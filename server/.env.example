# Copie para .env (o .env nunca vai para o Git) e ajuste.

# Porta da API
PORT=3000

# Segredo para assinar os logins (JWT). Obrigatório em produção, mínimo 16 caracteres.
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Arquivo onde os dados ficam (padrão: server/data/barbearia.json)
# DATA_FILE=./data/barbearia.json

# Endereços do front-end autorizados a chamar a API (separados por vírgula)
CORS_ORIGIN=http://localhost:5173

# Só para o seed (desenvolvimento): login de teste
# SEED_EMAIL=barbeiro@exemplo.com
# SEED_SENHA=troque-esta-senha
